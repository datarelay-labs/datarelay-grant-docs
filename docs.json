{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DataRelay Grant",
  "description": "Human approval and execution control for automated actions.",
  "colors": {
    "primary": "#C2410C",
    "light": "#FB923C",
    "dark": "#C75A00"
  },
  "navbar": {
    "links": [
      {
        "label": "DataRelay",
        "href": "https://datarelay.run/"
      },
      {
        "label": "Link",
        "href": "https://link.datarelay.run/"
      },
      {
        "label": "Control",
        "href": "https://control.datarelay.run/"
      },
      {
        "label": "Grant",
        "href": "https://grant.datarelay.run/"
      },
      {
        "label": "Engineering",
        "href": "https://engineering.datarelay.run/"
      },
      {
        "type": "github",
        "href": "https://github.com/datarelay-labs/datarelay-grant"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Patent Foundation",
      "href": "/patent-foundation"
    }
  },
  "search": {
    "prompt": "Search DataRelay Grant docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "DataRelay Grant",
            "icon": "shield-check",
            "pages": [
              "index",
              "patent-foundation"
            ]
          }
        ]
      },
      {
        "language": "ko",
        "groups": [
          {
            "group": "DataRelay Grant",
            "icon": "shield-check",
            "pages": [
              "ko/index",
              "ko/patent-foundation"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://grant.datarelay.run/"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://grant.datarelay.run"
    },
    "indexing": "navigable"
  },
  "appearance": {
    "default": "system",
    "strict": false
  }
}
